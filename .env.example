# Supabase (opcional — sin estas variables, la analítica hace log a consola del
# servidor en vez de persistir, el límite de peticiones se desactiva y la
# caché de previsión no se usa, pero el resto de la app funciona igual).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protege /api/cron/refresh-cache y /api/cron/check-alerts para que no sean
# rutas públicas que cualquiera pueda golpear. Opcional: si se deja vacío,
# esas rutas no comprueban autorización (solo usar así en local). Genera
# uno con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Google Analytics 4 (opcional — sin esto, simplemente no se carga el script,
# igual que Supabase). El prefijo NEXT_PUBLIC_ es obligatorio: esta variable
# se usa en el navegador, no solo en el servidor.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Alertas push ("avísame cuando haya buenas condiciones") — opcional, sin
# esto el botón de alertas simplemente no aparece. Genera un par una única
# vez con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# La pública lleva NEXT_PUBLIC_ porque el navegador la necesita para
# suscribirse; la privada NUNCA debe llevar ese prefijo (firma los envíos,
# solo el servidor debe conocerla). Ver README, sección "Alertas".
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
