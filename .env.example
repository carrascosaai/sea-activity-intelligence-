# Supabase (opcional — sin estas variables, la analítica hace log a consola del
# servidor en vez de persistir, el límite de peticiones se desactiva y la
# caché de previsión no se usa, pero el resto de la app funciona igual).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protege /api/cron/refresh-cache para que no sea una ruta pública que
# cualquiera pueda golpear. Opcional: si se deja vacío, la ruta no comprueba
# autorización (solo usar así en local). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
